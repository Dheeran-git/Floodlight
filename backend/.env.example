# Floodlight Backend Environment Variables

# Database (leave empty for SQLite fallback)
DATABASE_URL=

# AI Services (left empty -> deterministic rule-based fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=

# Optimization risk simulation (optional)
WOLFRAM_APP_ID=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
DEBUG=true
