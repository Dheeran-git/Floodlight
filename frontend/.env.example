# Floodlight Frontend Environment Variables
# Copy to .env.local and fill in values. All vars must be prefixed with VITE_.

# (No map token is required; the app uses open-source MapLibre GL maps).

# Base URL of the Floodlight backend API, including the /api/v1 path.
# Leave unset for local dev (Vite proxies /api to localhost:8000). In
# production (Vercel) set it to the deployed backend, e.g.:
#   VITE_API_URL=https://floodlight-api.onrender.com/api/v1
# The real-time WebSocket feed URL is derived from this automatically.
VITE_API_URL=
