# ===========================
# Floodlight Environment Variables
# ===========================

# Application
APP_NAME=Floodlight
DEBUG=true
ENVIRONMENT=development

# Database
# For local dev, leave empty to use SQLite fallback
DATABASE_URL=postgresql://user:password@localhost:5432/floodlight

# AI Services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=

# Mapping
MAPBOX_TOKEN=

# Wolfram
WOLFRAM_APP_ID=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
